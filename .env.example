# =============================================================================
# HASC environment configuration — EXAMPLE (placeholders only, no real secrets)
# =============================================================================
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
# This file is consumed by docker-compose.yml (single-VPS deployment).

# -----------------------------------------------------------------------------
# Application secret (REQUIRED — the backend refuses to start without it)
# -----------------------------------------------------------------------------
# Used to sign JWT access tokens. Generate a strong random value:
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Application database (Postgres service "db")
# -----------------------------------------------------------------------------
POSTGRES_USER=hasc
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=hasc_db
# Must match the credentials above and point at the compose service host "db".
# The backend normalizes postgresql:// to the async driver automatically.
DATABASE_URL=postgresql+asyncpg://hasc:CHANGE_ME_strong_db_password@db:5432/hasc_db

# -----------------------------------------------------------------------------
# Upload directories (inside the backend container; backed by named volumes)
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
TEMP_UPLOAD_DIR=/app/temp_uploads

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed browser origins
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=https://hascvn.id.vn,https://admin.hascvn.id.vn

# -----------------------------------------------------------------------------
# Umami analytics database (Postgres service "umami-db")
# -----------------------------------------------------------------------------
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=CHANGE_ME_strong_umami_db_password
UMAMI_POSTGRES_DB=umami
# Random salt for umami password hashing:  openssl rand -hex 16
UMAMI_HASH_SALT=CHANGE_ME_random_salt

# -----------------------------------------------------------------------------
# Frontend build-time variables (Vite) — public + admin sites
# -----------------------------------------------------------------------------
VITE_UMAMI_ENABLED=false
VITE_UMAMI_SCRIPT_URL=https://umami.hascvn.id.vn/script.js
VITE_UMAMI_DASHBOARD_URL=https://umami.hascvn.id.vn
VITE_UMAMI_WEBSITE_ID_PUBLIC=CHANGE_ME_umami_public_website_id
VITE_UMAMI_WEBSITE_ID_ADMIN=CHANGE_ME_umami_admin_website_id
VITE_API_BASE_URL_PUBLIC=https://hascvn.id.vn
VITE_API_BASE_URL_ADMIN=https://admin.hascvn.id.vn

# -----------------------------------------------------------------------------
# TLS / Let's Encrypt (used by ./nginx/init-letsencrypt.sh, not by compose)
# -----------------------------------------------------------------------------
# Email for expiry/renewal notices (strongly recommended).
CERTBOT_EMAIL=you@example.com
# Space-separated; the FIRST domain names the cert lineage and must match the
# ssl_certificate path in nginx/nginx.conf.
CERTBOT_DOMAINS=hascvn.id.vn admin.hascvn.id.vn umami.hascvn.id.vn
# Set to 1 while testing to use the Let's Encrypt staging CA (avoids rate limits;
# certificates will NOT be browser-trusted). Set to 0 for real certificates.
CERTBOT_STAGING=0
