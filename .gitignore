# =====================
# OS / Editor junk
# =====================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log

# =====================
# Environment / secrets
# =====================
.env
.env.*
!.env.example

# =====================
# TLS certificates / private keys
# (mount real certs at deploy time; never commit them)
# =====================
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
nginx/certs/*
!nginx/certs/README.md

# =====================
# SQLite databases (dev/test artifacts, regenerated on demand)
# =====================
*.db
*.sqlite
*.sqlite3

# =====================
# Backups (database dumps + upload archives) — never commit
# =====================
/backups/
*.sql.gz

# =====================
# Uploaded / generated media (served from a volume in production)
# =====================
uploads/
temp_uploads/
backend/uploads/
backend/temp_uploads/

# =====================
# Dependencies
# =====================
node_modules/
vendor/
__pycache__/
*.py[cod]

# =====================
# Build outputs
# =====================
dist/
build/
out/
target/
*.exe
*.dll
*.so
*.dylib

# =====================
# Package managers
# =====================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================
# Testing / coverage
# =====================
coverage/
.nyc_output/
pytest_cache/

# =====================
# Temporary files
# =====================
tmp/
temp/
.cache/

# =====================
# Docker
# =====================
docker-compose.override.yml

# =====================
# Misc
# =====================
*.bak
*.tmp

.venv